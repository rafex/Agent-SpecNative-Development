[agent]
# Set this to the model exposed by your OpenAI-compatible endpoint.
model = ""
api_base = ""
api_key_env = "OPENAI_API_KEY"
question_mode = "single"
history = true
# Optional OpenAI-compatible embeddings profile; key defaults to the chat key.
# Validate with `asn --test-embeddings` before enabling vector search.
# embedding_model = "nomic-embed-text-v1.5"
# embedding_api_base = "https://api.groq.com/openai/v1"
# embedding_api_key_env = "EMBEDDINGS_API_KEY"
max_steps = 12
# Optional provider reasoning level (for example: low, medium, high).
# GPT-OSS defaults to low for every provider when this setting is unset.
# SPECNATIVE_AGENT_REASONING_EFFORT overrides this value when set.
reasoning_effort = ""
# Groq service tier for any chat model: auto (default), on_demand, flex, performance.
# service_tier = "auto"

[mcp]
python = ".specnative/.venv/bin/python"
script = ".specnative/specnative_mcp.py"

# Optional secure credential providers. With backend = "auto", ASN checks
# agent.secrets.yaml, then agent.gopass.toml, then the legacy environment.
[secrets]
backend = "auto"
file = ".specnative/agent.secrets.yaml"
gopass_file = ".specnative/agent.gopass.toml"

# SpecNative — venv is generated; do not commit
.specnative/.venv/
pilot/.venv/
pilot/.specnative/
pilot/build/
pilot/dist/

# Python bytecode is generated locally
__pycache__/
*.py[cod]

# Editable Python installs generate package metadata
*.egg-info/

# Optional pilot conversation history is local state
.specnative/agent/sessions/

# MkDocs output is generated locally and in CI
/site/

# Never commit decrypted secret material
.specnative/agent.secrets.dec.*
.specnative/*.decrypted.*
